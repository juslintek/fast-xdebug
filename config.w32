// $Id$
// vim:ft=javascript

ARG_ENABLE("swiftcov", "Enable the swiftcov coverage engine", "no");

if (PHP_SWIFTCOV != "no") {
	AC_DEFINE("HAVE_SWIFTCOV", 1, "Have swiftcov support");
	EXTENSION("swiftcov", "swiftcov.c", null, "/Dswiftcov_EXPORTS");
	ADD_SOURCES(configure_module_dirname + "/src", "analysis.c coverage.c profiler.c debugger.c", "swiftcov");
}
